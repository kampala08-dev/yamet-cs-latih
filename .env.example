# Salin jadi .env (atau isi di Environment Docker Manager). Jangan commit .env.

# --- Wajib ---
# Kata sandi masuk peran admin (minimal 12 karakter). Buat sendiri, simpan di pengelola sandi.
CS_SANDI_ADMIN=
# Alamat webhook n8n tanpa garis miring di akhir (07 dan 11 aktif di sini).
CS_N8N_BASE=https://n8n-hc8x.srv2014501.hstgr.cloud/webhook
# Salin dari sheet "CS Bot YAMET", tab Konfigurasi, baris LATIH_SECRET (kolom Nilai).
CS_LATIH_SECRET=

# --- Opsional ---
# Kata sandi kedua untuk peran latih (tanpa nomor utuh, tanpa ubah Konfigurasi/Klien Aktif/eskalasi).
CS_SANDI_LATIH=
# Isi 1 hanya untuk uji tampilan dengan data tiruan (tidak memanggil n8n).
CS_MOCK=
# Batas tunggu jawaban n8n dalam milidetik (bawaan 90000).
CS_N8N_TIMEOUT_MS=

# --- Deploy lewat docker-compose.yml ---
# Domain halaman, mis. latih.yametpalembang.io (A record ke IP VPS).
CS_DOMAIN=
# Repo GitHub berisi folder ini. Repo privat: https://<token-baca-saja>@github.com/<akun>/<repo>.git
CS_REPO_URL=
# Cabang (bawaan main) dan folder di dalam repo tempat package.json ini (bawaan .).
CS_REPO_CABANG=
CS_REPO_FOLDER=
